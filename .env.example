# Public URL of this storefront
NEXT_PUBLIC_URL=http://localhost:3000

# Current test account uses its production branch. Copy actual URLs into ignored .env.local.
NEON_BRANCH=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

#Razorpay credentials for payment processing
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Keep disabled until merchant price lists, shipping, tax, and provider access are approved.
CHECKOUT_ENABLED=false
